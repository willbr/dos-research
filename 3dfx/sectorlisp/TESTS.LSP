; Original list evaluator plus numbers, persistent definitions and recursion.
(assert (eq (car '(a b c)) 'a))
(assert (eq (cdr '(a . b)) 'b))
(assert (eq (car nil) nil))
(assert (eq (cdr nil) nil))
(assert (atom 'a))
(assert (atom nil))
(assert (eq (atom '(a)) nil))
(assert (eq (cdr (cons 'a 'b)) 'b))
(assert (eq 'foo 'FOO))
(assert (eq 00012 12))
(assert (eq -2147483648 -2147483648))
(assert (eq (+ 6 7) 13))
(assert (eq (- 6 7) -1))
(assert (eq (* -6 7) -42))
(assert (eq (cond (nil 1) (t 2)) 2))
(assert (eq (cond (nil 1)) nil))
(assert (eq (cond (0 7)) 7)) ; zero is true in Lisp
(define identity (lambda (x) x))
(assert (eq (identity 'hello) 'hello))
(assert (eq ((lambda (x) (+ x 1)) 41) 42))
(assert (eq (progn 1 2 3) 3))
(define factorial
  (lambda (n)
    (cond ((< n 2) 1)
          (t (* n (factorial (- n 1)))))))
(assert (eq (factorial 6) 720))
(assert (eq ((label sum (lambda (n)
              (cond ((< n 1) 0) (t (+ n (sum (- n 1))))))) 10) 55))
(define saved '(persistent (a b) . tail))
(assert (eq (car saved) 'persistent))
(define saved-number 17)
(define saved-number (+ saved-number 1))
(assert (eq saved-number 18))
; READ consumes the next form in this source stream.
(assert (eq (read) 'following-form)) following-form
